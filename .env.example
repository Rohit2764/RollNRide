# Environment Configuration for RollNRide
ENVIRONMENT=development
PROJECT_NAME="RollNRide"
API_V1_STR="/api"

# Database Configuration (SQLite default for seamless local run, or PostgreSQL)
# Local SQLite: sqlite:///./rollnride.db
# PostgreSQL: postgresql+psycopg2://rollnride:rollnride_secret@localhost:5432/rollnride_db
DATABASE_URL=sqlite:///./rollnride.db

# Redis Cache & Realtime State (Optional for local memory fallback, required for multi-worker Docker)
REDIS_URL=redis://localhost:6379/0

# Security & JWT Auth
JWT_SECRET=super_secret_rollnride_jwt_key_development_change_in_production_987654321
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Network & URLs
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Live Fleet Simulation
SIMULATION_ENABLED=true
SIMULATION_SPEED=1.0

# Maps & Routing
MAP_PROVIDER=leaflet
MAP_PROVIDER_KEY=

# Email / Notifications (Optional Mock fallback)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=notifications@rollnride.com
